# Netlify response headers (https://docs.netlify.com/routing/headers/)
# 公開ディレクトリ直下に置く（_redirects と同じ場所）。

# 全ページ共通のセキュリティヘッダー
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# フォントはファイル名が変わらない限り中身も変わらないため、長期キャッシュ
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 画像・アイコンは 7 日キャッシュ（同名で差し替えた場合は最大 7 日古いものが出る）
/Images/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# CSS / JS / HTML はファイル名にバージョンが無いため、Netlify 既定（毎回再検証）のまま
